{
  "manifest_version": 3,
  "name": "Сохранить видеопоток",
  "version": "0.1.0",
  "description": "Находит HLS и MP4 на открытой странице и сохраняет видео на диск.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Найти видео на этой странице"}
}
